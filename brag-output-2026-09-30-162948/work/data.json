  "code": {
    "interface": [
      "type Parser interface {",
      "\tName() string",
      "\tDetect(line string) bool",
      "\tParse(line string) (schema.Event, error)",
      "}"
    ],
    "extract_before": [
      "func extractField(line, key string) string {",
      "\tre := regexp.MustCompile(",
      "\t\t`(?:^|\\s)` + regexp.QuoteMeta(key) + `=([^\\s]+)`)",
      "\treturn re.FindStringSubmatch(line)[1]",
      "}"
    ],
    "extract_after": [
      "func extractField(line, key string) string {",
      "\ti := strings.Index(line, key+\"=\")   // no compile, no alloc",
      "\tif i < 0 { return \"\" }",
      "\tv := line[i+len(key)+1:]",
      "\tif j := strings.IndexAny(v, \" \\t\"); j >= 0 { v = v[:j] }",
      "\treturn v                            // substring of input: 0 allocs",
      "}"
    ],
    "pool_select": [
      "select {",
      "case p.Out <- ev:                    // fast path",
      "case <-ctx.Done():",
      "case <-time.After(SpillTimeout):      // 2s",
      "\tp.Stats.Spilled.Add(1)",
      "\tspill(p.SpillDir, ev)               // to disk, never dropped",
      "}"
    ],
    "writer": [
      "batch = append(batch, ev)",
      "if len(batch) >= BatchSize {        // 500",
      "\tflush()                          // one tx, WAL commit",
      "\ttimer.Reset(FlushInterval)         // 100ms trickle backstop",
      "}",
      "...",
